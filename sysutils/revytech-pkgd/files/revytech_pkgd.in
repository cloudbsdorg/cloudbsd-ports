#!/bin/sh

# PROVIDE: revytech_pkgd
# REQUIRE: NETWORKING
# KEYWORD: shutdown

. /etc/rc.subr

name="revytech_pkgd"
rcvar="revytech_pkgd_enable"
pidfile="/var/run/${name}.pid"
procname="%%PREFIX%%/sbin/revytech-pkgd"

load_rc_config ${name}

: ${revytech_pkgd_enable:="NO"}
: ${revytech_pkgd_listen:="127.0.0.1:8081"}
: ${revytech_pkgd_series:="%%PREFIX%%/etc/pkg-repo/series.json"}
: ${revytech_pkgd_state:="/var/db/revytech-pkgd/state.json"}
: ${revytech_pkgd_nginx_out:="%%PREFIX%%/etc/nginx/series-vhosts.conf"}
: ${revytech_pkgd_config:="%%PREFIX%%/etc/pkg-repo/pkgd.json"}
: ${revytech_pkgd_flags:=""}

command="/usr/sbin/daemon"
# -p = child pid so `service status` matches procname. Do not use -r.
command_args="-p ${pidfile} -f ${procname} \
	-config ${revytech_pkgd_config} \
	${revytech_pkgd_flags}"

start_precmd="revytech_pkgd_prestart"

revytech_pkgd_prestart()
{
	install -d -m 0755 /var/db/revytech-pkgd
	if [ -x "${procname}" ]; then
		"${procname}" -config "${revytech_pkgd_config}" \
		    -write-nginx "${revytech_pkgd_nginx_out}" || true
		if [ -x %%PREFIX%%/etc/rc.d/nginx ]; then
			nginx -t >/dev/null 2>&1 && service nginx reload >/dev/null 2>&1 || true
		fi
	fi
}

run_rc_command "$1"
