[
{ type: install
  message: <<EOM
Nexus Repository Manager %%VERSION%% has been successfully installed!

IMPORTANT: Nexus runs by default as user %%USER%%!

To enable Nexus on boot:
  service %%NEXUS_RC%% enable

To start/stop Nexus:
  service %%NEXUS_RC%% start
  service %%NEXUS_RC%% stop
  service %%NEXUS_RC%% status

Default URL: http://localhost:8081/

Locations:
  Binary:    %%HOME%%/bin/nexus
  Config:    %%HOME%%/etc
  Data:      %%WORKDIR%%
  Logs:      %%LOGDIR%%
  PID:       %%RUNDIR%%/nexus3.pid

The rc script will automatically restart Nexus if it crashes (daemon -r).

Initial password is stored in: %%WORKDIR%%/admin.password
EOM
},
{ type: upgrade
  message: <<EOM
Nexus Repository Manager %%VERSION%% has been upgraded!

If Nexus was running during the upgrade, it has been automatically restarted.
Otherwise, start it manually:
  service %%NEXUS_RC%% start
EOM
},
{ type: remove
  message: <<EOM
Consider deleting %%WORKDIR%%, %%LOGDIR%%, and %%RUNDIR%% manually!
EOM
}
]
