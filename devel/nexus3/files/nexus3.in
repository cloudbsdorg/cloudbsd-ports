#!/bin/sh

# PROVIDE: %%NEXUS_RC%%
# REQUIRE: LOGIN FILESYSTEMS NETWORKING
# KEYWORD: shutdown
#
# Add the following line to /etc/rc.conf[.local] to enable Nexus:
#
#  %%NEXUS_RC%%_enable="YES"

. /etc/rc.subr

name=%%NEXUS_RC%%
desc="%%DESC%%"
rcvar=%%NEXUS_RC%%_enable

load_rc_config ${name}

%%NEXUS_RC%%_enable="${%%NEXUS_RC%%_enable:-"NO"}"
%%NEXUS_RC%%_user=%%USER%%
%%NEXUS_RC%%_group=%%GROUP%%

nexus_home="%%HOME%%"
nexus_bin="${nexus_home}/bin/nexus"
nexus_workdir="%%WORKDIR%%"
pidfile="%%RUNDIR%%/nexus3.pid"
logfile="%%LOGDIR%%/nexus.log"

# Ensure required directories and symlinks exist
setup_nexus_dirs() {
    # Create symlink for sonatype-work if not exists
    if [ ! -e %%PREFIX%%/sonatype-work ] && [ ! -L %%PREFIX%%/sonatype-work ]; then
        ln -sf %%WORKDIR%% %%PREFIX%%/sonatype-work
    fi
    # Create work directories if not exist
    mkdir -p ${nexus_workdir}/log ${nexus_workdir}/tmp
    # Ensure nexus binary is executable
    chmod +x ${nexus_bin} 2>/dev/null
    # Set ownership on data directories
    chown -R %%USER%%:%%GROUP%% %%WORKDIR%% 2>/dev/null
    chown -R %%USER%%:%%GROUP%% %%PREFIX%%/sonatype-work 2>/dev/null
}

command="/usr/sbin/daemon"
command_args="-r -p ${pidfile} -o ${logfile} -u %%USER%% ${nexus_bin} run"

start_cmd=nexus_start
stop_cmd=nexus_stop
status_cmd=nexus_status

nexus_start() {
    setup_nexus_dirs
    check_process
    if [ "$?" -eq 1 ]; then
        echo "Starting ${name}."
        export INSTALL4J_JAVA_HOME=%%JAVA_HOME%%
        export JAVA_HOME=%%JAVA_HOME%%
        /usr/sbin/daemon -r -p ${pidfile} -o ${logfile} -u %%USER%% ${nexus_bin} run
        sleep 2
        if [ ! -f ${pidfile} ] || ! kill -0 $(cat ${pidfile}) 2>/dev/null; then
            echo "${name} failed to start. Check ${logfile}."
        fi
    else
        echo "${name} is already running."
    fi
}

nexus_stop() {
    check_process
    if [ "$?" -eq 1 ]; then
        echo "${name} is not running."
    else
        echo "Stopping ${name}."
        pid=$(cat ${pidfile} 2>/dev/null)
        # Kill the daemon process
        if [ -n "${pid}" ] && [ "${pid}" -gt 0 ] 2>/dev/null; then
            kill ${pid} 2>/dev/null
        fi
        # Also kill any child Java processes
        pkill -f "${nexus_bin}" 2>/dev/null
        for i in $(seq 1 30); do
            if ! pgrep -f "${nexus_bin}" > /dev/null 2>&1; then
                rm -f ${pidfile}
                break
            fi
            sleep 1
        done
        # Force kill if still running
        if pgrep -f "${nexus_bin}" > /dev/null 2>&1; then
            pkill -9 -f "${nexus_bin}" 2>/dev/null
            rm -f ${pidfile}
        fi
    fi
}

nexus_status() {
    check_process
    if [ "$?" -eq 1 ]; then
        echo "${name} is not running."
        return 1
    else
        echo "${name} is running as pid $(cat ${pidfile})."
        return 0
    fi
}

check_process() {
    pid=$(cat ${pidfile} 2>/dev/null)
    if [ -f ${pidfile} ] && [ -n "${pid}" ] && [ "${pid}" -gt 0 ] 2>/dev/null; then
        if kill -0 ${pid} 2>/dev/null; then
            return 0
        fi
        # Stale PID file — remove it
        rm -f ${pidfile}
    fi
    return 1
}

run_rc_command "$1"
