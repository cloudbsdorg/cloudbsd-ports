# Nexus Repository Manager 3 - Java Runtime Configuration
# This file is sourced by the nexus startup script
# Values here override the defaults in nexus.vmoptions
#
# NOTE: This file is NOT overwritten during upgrades if it exists.
# To reset to defaults, delete this file.

# Minimum heap size (default: 2703m - minimum safe for Nexus 3)
# NEXUS_XMS=2703m

# Maximum heap size (default: 2703m - minimum safe for Nexus 3)
# NEXUS_XMX=2703m

# Additional Java options (uncomment and customize as needed)
# NEXUS_JAVA_OPTS="-XX:+UseG1GC -XX:+UseStringDeduplication"

# =============================================================================
# Automated Backup Configuration (BACKUP option)
# =============================================================================
# Enable automated backups (default: NO)
# nexus_backup_enable=NO

# Backup directory (default: /var/backups/nexus3)
# nexus_backup_dir=/var/backups/nexus3

# Backup retention in days (default: 7)
# nexus_backup_retention=7

# =============================================================================
# Prometheus Metrics Configuration (METRICS option)
# =============================================================================
# Metrics are available at: http://localhost:8081/service/metrics
# Enable via Nexus web UI: Administration -> System -> Capabilities -> Metrics Collector
# Or add to /usr/local/nexus3/etc/nexus.properties: nexus.metrics.enabled=true
