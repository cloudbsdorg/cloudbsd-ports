#!/bin/sh
#
# Copyright (c) 2026 REVYTECH, Inc.
# SPDX-License-Identifier: BSD-3-Clause
#
# PROVIDE: openproject
# REQUIRE: LOGIN postgresql memcached
# KEYWORD: shutdown
#
# OpenProject Puma on 127.0.0.1:3000. Modeled on www/gitlab rc.d
# plus CloudBSD checkconfig/doctor. The good_job worker is
# rc.d/openproject_worker. nginx is already the jail reverse proxy.
#
# openproject_enable (bool):	default NO
# openproject_user (str):	default %%USERS%%
# openproject_group (str):	default %%GROUPS%%
# openproject_envfile (str):	ENV file OpenProject actually consumes
# openproject_args (str):	extra Puma args (default bind 127.0.0.1:3000)

. /etc/rc.subr

name="openproject"
desc="OpenProject Rails application (Puma)"
rcvar="openproject_enable"

load_rc_config ${name}

: ${openproject_enable:="NO"}
: ${openproject_user:="%%USERS%%"}
: ${openproject_group:="%%GROUPS%%"}
: ${openproject_envfile:="%%PREFIX%%/etc/cloudbsd/openproject/openproject.env"}
: ${openproject_pidfile:="/var/run/openproject/openproject.pid"}
: ${openproject_args="--bind tcp://127.0.0.1:3000 -e production"}

pidfile="${openproject_pidfile}"
procname="%%PREFIX%%/bin/ruby"
command="/usr/sbin/daemon"
command_args="-c -f -P ${pidfile} -u ${openproject_user} -T ${name} -t ${name} \
	%%PREFIX%%/sbin/openproject supervise"

extra_commands="doctor checkconfig"
doctor_cmd="openproject_doctor"
checkconfig_cmd="openproject_checkconfig"
start_precmd="openproject_prestart"
stop_postcmd="openproject_poststop"

export OPENPROJECT_ENVFILE="${openproject_envfile}"
export PATH="${PATH}:%%PREFIX%%/bin"

openproject_checkconfig()
{
	%%PREFIX%%/sbin/openproject checkconfig
}

openproject_doctor()
{
	%%PREFIX%%/sbin/openproject doctor
}

openproject_prestart()
{
	openproject_checkconfig || return 1
	install -d -o "${openproject_user}" -g "${openproject_group}" \
		-m 0755 /var/run/openproject \
		/var/log/openproject \
		/var/db/openproject \
		%%WWWDIR%%/tmp/pids
}

openproject_poststop()
{
	rm -f "${pidfile}"
}

run_rc_command "$1"
