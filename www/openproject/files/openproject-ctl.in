#!/bin/sh
#
# Copyright (c) 2026 REVYTECH, Inc.
# SPDX-License-Identifier: BSD-3-Clause
#
# CloudBSD helper for official OpenProject. Does not relicense
# OpenProject (GPLv3).
#
# OpenProject consumes environment variables, not JSON. The env file
# is the runtime config. Optional JSON can generate that env file.

set -eu

PREFIX="%%PREFIX%%"
WWWDIR_DEFAULT="%%WWWDIR%%"
VERSION="%%VERSION%%"

: "${OPENPROJECT_ENVFILE:=${PREFIX}/etc/cloudbsd/openproject/openproject.env}"
: "${OPENPROJECT_CONFIG:=${PREFIX}/etc/cloudbsd/openproject/config.json}"

umask 077

usage()
{
	echo "usage: openproject checkconfig | doctor | env | migrate | secret | supervise | supervise-worker | version" >&2
	exit 2
}

die()
{
	echo "openproject: $*" >&2
	exit 1
}

need_jq()
{
	command -v jq >/dev/null 2>&1 || die "jq is required (textproc/jq)"
}

cfg()
{
	jq -er "$1" "${OPENPROJECT_CONFIG}" 2>/dev/null || echo "$2"
}

filemode()
{
	if stat -f %OLp "$1" >/dev/null 2>&1; then
		stat -f %OLp "$1"
	else
		stat -c %a "$1"
	fi
}

read_secret_line()
{
	_sf="$1"
	[ -f "${_sf}" ] || die "missing secret file: ${_sf}"
	_mode=$(filemode "${_sf}")
	case "${_mode}" in
	600|400|0600|0400) ;;
	*)
		die "secret file ${_sf} must be mode 0600 (is ${_mode})"
		;;
	esac
	sed -n '1p' "${_sf}" | tr -d '\r\n'
}

json_ok()
{
	jq -e . "${OPENPROJECT_CONFIG}" >/dev/null 2>&1
}

uri_encode()
{
	jq -nr --arg p "$1" '$p|@uri'
}

tcp_open()
{
	_host="$1"
	_port="$2"
	if command -v nc >/dev/null 2>&1; then
		nc -z -w 2 "${_host}" "${_port}" >/dev/null 2>&1
		return $?
	fi
	return 1
}

env_get()
{
	# KEY default — read KEY=value from the env file (no source)
	_k="$1"
	_d="$2"
	_v=$(sed -n "s/^${_k}=//p" "${OPENPROJECT_ENVFILE}" 2>/dev/null | sed -n '1p')
	if [ -n "${_v}" ]; then
		printf '%s' "${_v}"
	else
		printf '%s' "${_d}"
	fi
}

checkconfig()
{
	[ -f "${OPENPROJECT_ENVFILE}" ] || \
		die "env file missing: ${OPENPROJECT_ENVFILE} (OpenProject reads ENV, not JSON; copy openproject.env.sample)"
	_mode=$(filemode "${OPENPROJECT_ENVFILE}")
	case "${_mode}" in
	600|400|0600|0400) ;;
	*)
		die "env file must be mode 0600 (is ${_mode})"
		;;
	esac
	_host=$(env_get OPENPROJECT_HOST__NAME '')
	_https=$(env_get OPENPROJECT_HTTPS '')
	_db=$(env_get DATABASE_URL '')
	_sk=$(env_get SECRET_KEY_BASE '')
	_bindh=$(env_get HOST '127.0.0.1')
	_bindp=$(env_get PORT '3000')
	[ -n "${_host}" ] || die "OPENPROJECT_HOST__NAME is required"
	[ -n "${_https}" ] || die "OPENPROJECT_HTTPS is required"
	[ -n "${_db}" ] || die "DATABASE_URL is required"
	[ -n "${_sk}" ] || die "SECRET_KEY_BASE is required"
	[ "${_sk}" != "REPLACE_ME" ] || \
		die "SECRET_KEY_BASE is still REPLACE_ME; generate a unique persistent value"
	case "${_db}" in
	*REPLACE_ME*)
		die "DATABASE_URL still contains REPLACE_ME"
		;;
	esac
	case "${_bindh}" in
	127.0.0.1|localhost|::1) ;;
	*)
		echo "openproject: warning: HOST ${_bindh} is not loopback; track expects 127.0.0.1" >&2
		;;
	esac
	[ "${_bindp}" = "3000" ] || \
		echo "openproject: warning: PORT ${_bindp} is not 3000" >&2
	return 0
}

write_env_from_json()
{
	need_jq
	[ -f "${OPENPROJECT_CONFIG}" ] || die "JSON missing: ${OPENPROJECT_CONFIG}"
	json_ok || die "invalid JSON: ${OPENPROJECT_CONFIG}"
	_www=$(cfg '.wwwdir' "${WWWDIR_DEFAULT}")
	_addr=$(cfg '.bind.address' '127.0.0.1')
	_port=$(cfg '.bind.port' '3000')
	_host=$(cfg '.host_name' 'track.cloudbsd.org')
	_https=$(cfg '.https' 'true')
	_lang=$(cfg '.default_language' 'en')
	_rails=$(cfg '.rails_env' 'production')
	_pghost=$(cfg '.postgres.host' '127.0.0.1')
	_pgport=$(cfg '.postgres.port' '5432')
	_pgdb=$(cfg '.postgres.database' 'openproject')
	_pguser=$(cfg '.postgres.user' 'openproject')
	_skfile=$(cfg '.secret_key_base_file' '')
	_pwfile=$(cfg '.postgres.password_file' '')
	_mc_en=$(cfg '.memcached.enabled' 'true')
	_mc=$(cfg '.memcached.server' '127.0.0.1:11211')
	_datadir=$(cfg '.data_dir' '/var/db/openproject')
	[ -n "${_skfile}" ] || die "secret_key_base_file is required in JSON"
	[ -n "${_pwfile}" ] || die "postgres.password_file is required in JSON"
	_secret=$(read_secret_line "${_skfile}")
	_pw=$(read_secret_line "${_pwfile}")
	[ -n "${_secret}" ] || die "secret_key_base is empty"
	[ -n "${_pw}" ] || die "postgres password is empty"
	_pwe=$(uri_encode "${_pw}")
	_dburl="postgresql://${_pguser}:${_pwe}@${_pghost}:${_pgport}/${_pgdb}"

	_dir=$(dirname "${OPENPROJECT_ENVFILE}")
	mkdir -p "${_dir}"
	_tmp="${OPENPROJECT_ENVFILE}.tmp.$$"
	{
		echo "RAILS_ENV=${_rails}"
		echo "HOST=${_addr}"
		echo "PORT=${_port}"
		echo "SECRET_KEY_BASE=${_secret}"
		echo "DATABASE_URL=${_dburl}"
		echo "OPENPROJECT_HOST__NAME=${_host}"
		echo "OPENPROJECT_HTTPS=${_https}"
		echo "OPENPROJECT_DEFAULT__LANGUAGE=${_lang}"
		echo "OPENPROJECT_INSTALLATION__TYPE=manual"
		echo "OPENPROJECT_ATTACHMENTS__STORAGE__PATH=${_datadir}/files"
		if [ "${_mc_en}" = "true" ]; then
			echo "OPENPROJECT_RAILS__CACHE__STORE=memcache"
			echo "OPENPROJECT_CACHE__MEMCACHE__SERVER=${_mc}"
		else
			echo "OPENPROJECT_RAILS__CACHE__STORE=file_store"
		fi
		echo "RAILS_SERVE_STATIC_FILES=0"
		echo "HOME=${_datadir}"
		echo "BUNDLE_PATH=${_www}/vendor/bundle"
		echo "BUNDLE_WITHOUT=development:test"
	} > "${_tmp}"
	jq -r '.extra_env // {} | to_entries[] | select(.value|type=="string") | "\(.key)=\(.value)"' \
		"${OPENPROJECT_CONFIG}" >> "${_tmp}"
	chmod 0600 "${_tmp}"
	mv "${_tmp}" "${OPENPROJECT_ENVFILE}"
	echo "openproject: wrote ${OPENPROJECT_ENVFILE} from JSON"
}

load_env()
{
	checkconfig
	# shellcheck disable=SC1090
	set -a
	. "${OPENPROJECT_ENVFILE}"
	set +a
}

doctor()
{
	_fail=0
	_ok() { echo "    OK   $*"; }
	_bad() { echo "    FAIL $*"; _fail=1; }
	_wrn() { echo "    WARN $*"; }

	echo "==> env (OpenProject consumes this, not JSON)"
	if [ -f "${OPENPROJECT_ENVFILE}" ]; then
		_ok "${OPENPROJECT_ENVFILE}"
		if checkconfig >/dev/null 2>&1; then
			_ok "required ENV vars"
		else
			_bad "checkconfig failed"
		fi
		_mode=$(filemode "${OPENPROJECT_ENVFILE}")
		case "${_mode}" in
		600|400|0600|0400) _ok "env file mode ${_mode}" ;;
		*) _bad "env file mode ${_mode} (want 0600)" ;;
		esac
	else
		_bad "missing ${OPENPROJECT_ENVFILE}"
	fi
	if [ -f "${OPENPROJECT_CONFIG}" ]; then
		_ok "optional JSON wrapper ${OPENPROJECT_CONFIG}"
	else
		_wrn "no JSON wrapper (ok; ENV is what OpenProject reads)"
	fi

	_pid="/var/run/openproject/openproject.pid"
	_wpid="/var/run/openproject/openproject-worker.pid"
	echo "==> pidfile"
	if [ -d /var/run/openproject ]; then
		_ok "directory /var/run/openproject"
	else
		_wrn "directory /var/run/openproject absent (rc.d creates it on start)"
	fi
	if [ -f "${_pid}" ]; then
		_p=$(sed -n '1p' "${_pid}" | tr -d ' ')
		if [ -n "${_p}" ] && kill -0 "${_p}" 2>/dev/null; then
			_ok "puma pid ${_p}"
		else
			_wrn "stale puma pidfile"
		fi
	else
		_wrn "puma pidfile absent (service not running)"
	fi
	if [ -f "${_wpid}" ]; then
		_p=$(sed -n '1p' "${_wpid}" | tr -d ' ')
		if [ -n "${_p}" ] && kill -0 "${_p}" 2>/dev/null; then
			_ok "worker pid ${_p}"
		else
			_wrn "stale worker pidfile"
		fi
	else
		_wrn "worker pidfile absent (service not running)"
	fi

	_db=$(env_get DATABASE_URL 'postgresql://openproject@127.0.0.1:5432/openproject')
	_pghost=$(printf '%s' "${_db}" | sed -n 's#.*@\([^:/]*\).*#\1#p')
	_pgport=$(printf '%s' "${_db}" | sed -n 's#.*@[^:]*:\([0-9]*\)/.*#\1#p')
	[ -n "${_pghost}" ] || _pghost=127.0.0.1
	[ -n "${_pgport}" ] || _pgport=5432
	echo "==> postgres"
	if tcp_open "${_pghost}" "${_pgport}"; then
		_ok "${_pghost}:${_pgport} reachable"
	else
		_bad "${_pghost}:${_pgport} not reachable"
	fi
	if command -v pg_isready >/dev/null 2>&1; then
		if pg_isready -h "${_pghost}" -p "${_pgport}" -q; then
			_ok "pg_isready"
		else
			_bad "pg_isready failed"
		fi
	fi

	_mc=$(env_get OPENPROJECT_CACHE__MEMCACHE__SERVER '127.0.0.1:11211')
	_store=$(env_get OPENPROJECT_RAILS__CACHE__STORE 'memcache')
	echo "==> memcached"
	if [ "${_store}" = "memcache" ]; then
		_mch=${_mc%%:*}
		_mcp=${_mc##*:}
		if tcp_open "${_mch}" "${_mcp}"; then
			_ok "${_mc} reachable"
		else
			_bad "${_mc} not reachable"
		fi
	else
		_wrn "cache store is ${_store} (memcached not required)"
	fi

	_addr=$(env_get HOST '127.0.0.1')
	_port=$(env_get PORT '3000')
	echo "==> bind"
	_ok "configured ${_addr}:${_port}"
	if tcp_open "${_addr}" "${_port}"; then
		_ok "listener present on ${_addr}:${_port}"
	else
		_wrn "nothing listening on ${_addr}:${_port}"
	fi

	_www="${WWWDIR_DEFAULT}"
	echo "==> application"
	if [ -f "${_www}/Gemfile" ] && [ -f "${_www}/config.ru" ]; then
		_ok "${_www} (Gemfile, config.ru)"
	else
		_bad "${_www} missing Gemfile or config.ru"
	fi
	if [ -d "${_www}/vendor/bundle" ]; then
		_ok "vendor/bundle present"
	else
		_wrn "vendor/bundle absent (port build compiles native gems)"
	fi

	if [ "${_fail}" -ne 0 ]; then
		echo "openproject: doctor failed"
		return 1
	fi
	echo "openproject: doctor ok"
	return 0
}

do_migrate()
{
	load_env
	cd "${WWWDIR_DEFAULT}"
	${PREFIX}/bin/bundle exec rake db:migrate
}

do_supervise()
{
	load_env
	_addr="${HOST:-127.0.0.1}"
	_port="${PORT:-3000}"
	cd "${WWWDIR_DEFAULT}"
	exec ${PREFIX}/bin/bundle exec puma \
		--dir "${WWWDIR_DEFAULT}" \
		-e "${RAILS_ENV:-production}" \
		--bind "tcp://${_addr}:${_port}"
}

do_supervise_worker()
{
	load_env
	cd "${WWWDIR_DEFAULT}"
	exec ${PREFIX}/bin/bundle exec good_job start
}

do_secret()
{
	if command -v openssl >/dev/null 2>&1; then
		openssl rand -hex 64
	else
		die "openssl is required to generate SECRET_KEY_BASE"
	fi
}

[ $# -ge 1 ] || usage

case "$1" in
checkconfig)
	checkconfig
	echo "openproject: checkconfig ok"
	;;
doctor)
	doctor
	;;
env)
	write_env_from_json
	;;
migrate)
	do_migrate
	;;
secret)
	do_secret
	;;
supervise)
	do_supervise
	;;
supervise-worker)
	do_supervise_worker
	;;
version)
	echo "openproject ${VERSION}"
	;;
*)
	usage
	;;
esac
