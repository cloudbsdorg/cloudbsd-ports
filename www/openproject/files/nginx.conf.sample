#
# Sample nginx reverse proxy for OpenProject on track.cloudbsd.org.
# TLS is terminated here. Puma listens on 127.0.0.1:3000 only.
# Include from the jail's nginx server block, then enable the service.

upstream openproject {
	server 127.0.0.1:3000;
}

server {
	listen			443 ssl;
	listen			[::]:443 ssl;
	server_name		track.cloudbsd.org;

	# ssl_certificate and ssl_certificate_key come from certbot.

	client_max_body_size	2048m;

	location / {
		proxy_pass		http://openproject;
		proxy_set_header	Host			$host;
		proxy_set_header	X-Real-IP		$remote_addr;
		proxy_set_header	X-Forwarded-For		$proxy_add_x_forwarded_for;
		proxy_set_header	X-Forwarded-Proto	https;
		proxy_set_header	X-Forwarded-Host	$host;
		proxy_redirect		off;
	}
}
