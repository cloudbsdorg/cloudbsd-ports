#
# OpenProject reads environment variables, not JSON. Copy this file to
#   /usr/local/etc/cloudbsd/openproject/openproject.env
# and source it (openproject(8) does that). Mode 0600.
#
# SECRET_KEY_BASE must be unique per install and persistent across
# upgrades. Generate once:
#   openssl rand -hex 64
# Do not rotate it unless you intend to invalidate sessions/data.

RAILS_ENV=production
HOST=127.0.0.1
PORT=3000

# Replace REPLACE_ME. Persist this value.
SECRET_KEY_BASE=REPLACE_ME

# PostgreSQL 16 or 17. Change the password.
DATABASE_URL=postgresql://openproject:REPLACE_ME@127.0.0.1:5432/openproject

OPENPROJECT_HOST__NAME=track.cloudbsd.org
OPENPROJECT_HTTPS=true
OPENPROJECT_DEFAULT__LANGUAGE=en
OPENPROJECT_INSTALLATION__TYPE=manual

# memcached Rails cache (recommended)
OPENPROJECT_RAILS__CACHE__STORE=memcache
OPENPROJECT_CACHE__MEMCACHE__SERVER=127.0.0.1:11211

# nginx serves static files; Puma does not.
RAILS_SERVE_STATIC_FILES=0

HOME=/var/db/openproject
OPENPROJECT_ATTACHMENTS__STORAGE__PATH=/var/db/openproject/files
BUNDLE_PATH=/usr/local/www/openproject/vendor/bundle
BUNDLE_WITHOUT=development:test
